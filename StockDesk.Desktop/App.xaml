<Application x:Class="StockDesk.Desktop.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="CanvasBrush" Color="#F3F0F5"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFDFF"/>
    <SolidColorBrush x:Key="RailBrush" Color="#24202B"/>
    <SolidColorBrush x:Key="RailTextBrush" Color="#E4DCE9"/>
    <SolidColorBrush x:Key="TextBrush" Color="#2B2432"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#655A6F"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#663C79"/>
    <SolidColorBrush x:Key="TintBrush" Color="#EDE3F3"/>
    <SolidColorBrush x:Key="LineBrush" Color="#D9CFDF"/>

    <Style TargetType="Button">
      <Setter Property="Padding" Value="13,6"/>
      <Setter Property="Margin" Value="0,0,8,5"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonFrame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" Padding="{TemplateBinding Padding}" CornerRadius="5">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonFrame" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonFrame" Property="BorderThickness" Value="2"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonFrame" Property="Opacity" Value=".78"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonFrame" Property="Opacity" Value=".45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="8,5"/><Setter Property="Margin" Value="0,4,0,10"/>
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="Padding" Value="8,5"/><Setter Property="Margin" Value="0,4,0,10"/>
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
    </Style>
    <Style TargetType="ComboBox"><Setter Property="Padding" Value="6,4"/><Setter Property="Margin" Value="0,4,0,10"/></Style>
    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
      <Setter Property="RowBackground" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="AlternatingRowBackground" Value="#F8F4FA"/>
      <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource LineBrush}"/>
      <Setter Property="GridLinesVisibility" Value="Horizontal"/>
      <Setter Property="HeadersVisibility" Value="Column"/>
      <Setter Property="MinRowHeight" Value="27"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="{StaticResource TintBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="Padding" Value="7,8"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
  </Application.Resources>
</Application>
