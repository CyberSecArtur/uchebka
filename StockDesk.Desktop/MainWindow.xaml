<Window x:Class="StockDesk.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:StockDesk.Desktop.Views"
        Title="StockDesk · Склад оптовой фирмы" Width="1200" Height="760" MinWidth="920" MinHeight="590"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="14" Language="ru-RU"
        Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource TextBrush}">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="{DynamicResource RailBrush}" Padding="24,12">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="StockDesk" Foreground="White" FontSize="21" FontWeight="SemiBold"/>
        <TextBlock Text="Склад оптовой фирмы" Foreground="{DynamicResource RailTextBrush}" Margin="18,0,0,0" VerticalAlignment="Center"/>
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0"
            Background="{DynamicResource SurfaceBrush}" Padding="24,7">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" x:Name="SessionPanel" Orientation="Horizontal" Visibility="Collapsed" Margin="16,0,0,0">
          <TextBlock x:Name="Identity" Margin="0,0,12,0" VerticalAlignment="Center"/>
          <Button x:Name="SignOut" Content="Выйти" Click="Logout_Click" Margin="0"/>
        </StackPanel>
        <TextBlock x:Name="Message" AutomationProperties.Name="Сообщение приложения"
                   Text="Введите логин и пароль." TextWrapping="Wrap" VerticalAlignment="Center"/>
      </DockPanel>
    </Border>

    <Grid>
      <views:LoginView x:Name="LoginPanel"/>
      <TabControl x:Name="Workspace" Visibility="Collapsed" TabStripPlacement="Left"
                  Background="{DynamicResource SurfaceBrush}" BorderThickness="0">
        <TabControl.Template>
          <ControlTemplate TargetType="TabControl">
            <Grid KeyboardNavigation.TabNavigation="Local">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="172"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border Background="{DynamicResource RailBrush}" Padding="12,18">
                <TabPanel x:Name="HeaderPanel" IsItemsHost="True" KeyboardNavigation.TabIndex="1"/>
              </Border>
              <Border Grid.Column="1" Background="{DynamicResource CanvasBrush}">
                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
              </Border>
            </Grid>
          </ControlTemplate>
        </TabControl.Template>
        <TabControl.ItemContainerStyle>
          <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource RailTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="148"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                  <Border x:Name="Nav" Background="{TemplateBinding Background}" Padding="12,10" CornerRadius="5">
                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Nav" Property="Background" Value="#362D3F"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter TargetName="Nav" Property="Background" Value="{DynamicResource AccentBrush}"/>
                      <Setter Property="Foreground" Value="White"/>
                      <Setter Property="FontWeight" Value="SemiBold"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </TabControl.ItemContainerStyle>
        <TabItem Header="Заявки"><views:OrdersView x:Name="OrderPage"/></TabItem>
        <TabItem x:Name="CustomerTab" Header="Покупатели"><views:CustomersView x:Name="CustomerPage"/></TabItem>
        <TabItem Header="Отчётность"><views:StatisticsView x:Name="StatsPage"/></TabItem>
        <TabItem x:Name="UserTab" Header="Пользователи"><views:UsersView x:Name="UserPage"/></TabItem>
      </TabControl>
    </Grid>
  </DockPanel>
</Window>
