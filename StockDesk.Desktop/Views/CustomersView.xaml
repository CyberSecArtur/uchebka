<UserControl x:Class="StockDesk.Desktop.Views.CustomersView"
 Foreground="{DynamicResource TextBrush}" FontWeight="Normal"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
 mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="480">
    <DockPanel Margin="20,18">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                <WrapPanel DockPanel.Dock="Right">
                    <Button Content="Импорт CSV" Click="Import_Click"/>
                    <Button Content="Добавить покупателя" Click="AddCustomer_Click" Style="{DynamicResource PrimaryButton}" Margin="0"/>
                </WrapPanel>
                <TextBlock Text="Покупатели" FontSize="25" FontWeight="SemiBold"/>
            </DockPanel>
            <DataGrid x:Name="Customers" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False">
              <DataGrid.Columns><DataGridTextColumn Header="Покупатель" Binding="{Binding Name}" Width="*"/>
              <DataGridTextColumn Header="Адрес" Binding="{Binding Address}" Width="2*"/></DataGrid.Columns>
            </DataGrid>
          </DockPanel>
</UserControl>
