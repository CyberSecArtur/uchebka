<UserControl x:Class="StockDesk.Desktop.Views.UsersView"
 Foreground="{DynamicResource TextBrush}" FontWeight="Normal"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
 mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="480">
    <DockPanel Margin="20,18">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                <Button DockPanel.Dock="Right" Content="Добавить пользователя" Click="AddUser_Click"
                        Style="{DynamicResource PrimaryButton}" Margin="0"/>
                <TextBlock Text="Пользователи" FontSize="25" FontWeight="SemiBold"/>
            </DockPanel>
            <DataGrid x:Name="Users" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False">
              <DataGrid.Columns><DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="*"/>
              <DataGridTextColumn Header="Роль" Binding="{Binding Role}" Width="*"/></DataGrid.Columns>
            </DataGrid>
          </DockPanel>
</UserControl>
