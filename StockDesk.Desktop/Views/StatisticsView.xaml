<UserControl x:Class="StockDesk.Desktop.Views.StatisticsView"
 Foreground="{DynamicResource TextBrush}" FontWeight="Normal"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
 mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="480">
    <UserControl.Resources>
      <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="10"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/><Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12"/>
      </Style>
      <Style x:Key="Metric" TargetType="TextBlock">
        <Setter Property="FontSize" Value="25"/><Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Margin" Value="0,4,0,0"/>
      </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{DynamicResource CanvasBrush}">
      <StackPanel Margin="16">
        <DockPanel Margin="0,0,0,10" LastChildFill="True">
          <Button DockPanel.Dock="Right" Content="Обновить" Click="Refresh_Click" VerticalAlignment="Center"/>
          <StackPanel>
            <TextBlock Text="Отчётность" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
            <TextBlock Text="Заявки на отгрузку" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/>
          </StackPanel>
        </DockPanel>
        <UniformGrid Columns="4" Margin="0,0,0,10">
          <Border Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Text="Покупатели" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="CustomerMetric" Style="{StaticResource Metric}" d:Text="45"/></StackPanel></Border>
          <Border Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Text="Всего записей" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="TotalMetric" Style="{StaticResource Metric}" d:Text="45"/></StackPanel></Border>
          <Border Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Text="В работе" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="ActiveMetric" Style="{StaticResource Metric}" d:Text="8"/></StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Сумма отгрузок" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="RevenueMetric" Style="{StaticResource Metric}" FontSize="22" d:Text="128 500 ₽"/></StackPanel></Border>
        </UniformGrid>
        <Border Style="{StaticResource Card}" Margin="0,0,0,9">
          <StackPanel>
            <TextBlock Text="Сумма отгрузок по месяцам" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="Последние 6 месяцев · по дате отгрузки" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,9"/>
            <ItemsControl x:Name="RevenueChart">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate><DataTemplate>
                <Grid Margin="5,0">
                  <Grid.RowDefinitions><RowDefinition Height="107"/><RowDefinition Height="23"/></Grid.RowDefinitions>
                  <StackPanel VerticalAlignment="Bottom">
                    <TextBlock Text="{Binding Amount}" FontSize="12" HorizontalAlignment="Center" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,3"/>
                    <Border Background="{DynamicResource AccentBrush}" Height="{Binding Height}" CornerRadius="5,5,0,0" MaxWidth="68" Margin="8,0"/>
                  </StackPanel>
                  <Border Grid.Row="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0"><TextBlock Text="{Binding Label}" HorizontalAlignment="Center" Margin="0,3,0,0" Foreground="{DynamicResource MutedBrush}"/></Border>
                </Grid>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel><TextBlock Text="По статусам" FontSize="17" FontWeight="SemiBold"/>
          <ItemsControl x:Name="StatusChart" Margin="0,7,0,0">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource TintBrush}" CornerRadius="5" Padding="8,4" Margin="0,0,6,5"><TextBlock Text="{Binding}"/></Border></DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock x:Name="Duration" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0"/>
          </StackPanel>
        </Border>
        <WrapPanel x:Name="ExportButtons" Margin="0,12,0,0">
          <Button Content="Экспорт CSV" Tag="csv" Click="Export_Click"/>
          <Button Content="Экспорт JSON" Tag="json" Click="Export_Click"/>
          <Button Content="Экспорт XML" Tag="xml" Click="Export_Click"/>
        </WrapPanel>
      </StackPanel>
    </ScrollViewer>
</UserControl>
