<UserControl x:Class="StockDesk.Desktop.Views.OrdersView"
 Foreground="{DynamicResource TextBrush}" FontWeight="Normal"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
 mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="480">
    <DockPanel Margin="20,18">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
              <Button x:Name="AddOrder" DockPanel.Dock="Right" Content="Новая заявка"
                      Click="AddOrder_Click" Style="{DynamicResource PrimaryButton}" Margin="0"/>
              <TextBlock Text="Заявки на отгрузку" FontSize="25" FontWeight="SemiBold"/>
            </DockPanel>
            <ListBox x:Name="Filter" DockPanel.Dock="Top" AutomationProperties.Name="Фильтр статуса"
                     SelectionChanged="Filter_Changed" Margin="0,0,0,10" BorderThickness="0"
                     Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                  <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                  <Setter Property="Cursor" Value="Hand"/>
                  <Setter Property="Margin" Value="0,0,6,5"/>
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Frame" CornerRadius="5" Padding="10,6" BorderThickness="1"
                                BorderBrush="{DynamicResource LineBrush}" Background="{TemplateBinding Background}">
                          <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                          </Trigger>
                          <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </ListBox.ItemContainerStyle>
            </ListBox>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
              <WrapPanel DockPanel.Dock="Right">
                <Button x:Name="ChangeOrder" Content="Изменить статус" Click="ChangeOrder_Click"/>
                <Button Content="Обновить" Click="Refresh_Click" Margin="0,0,0,5"/>
              </WrapPanel>
              <StackPanel Orientation="Horizontal">
                <Label Content="Поиск" Target="{Binding ElementName=Search}" VerticalAlignment="Center" Padding="0,0,8,5"/>
                <TextBox x:Name="Search" Width="225" AutomationProperties.Name="Поиск по заявкам" Margin="0,0,0,5"
                         ToolTip="Номер, покупатель, адрес или товары" TextChanged="Search_Changed"/>
              </StackPanel>
            </DockPanel>
            <DataGrid x:Name="Orders" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single" CanUserAddRows="False">
              <DataGrid.Columns>
                <DataGridTextColumn Header="№" Binding="{Binding Id}" Width="52"/>
                <DataGridTextColumn Header="Покупатель" Binding="{Binding Customer}" Width="1.2*" MinWidth="105"/>
                <DataGridTextColumn Header="Адрес" Binding="{Binding Address}" Width="1.5*" MinWidth="105"/>
                <DataGridTextColumn Header="Товары" Binding="{Binding Description}" Width="1.7*" MinWidth="105"/>
                <DataGridTextColumn Header="Кладовщик" Binding="{Binding WarehouseWorker}" Width="*" MinWidth="105"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding StatusText}" Width="115"/>
                <DataGridTextColumn Header="Сумма, ₽" Binding="{Binding Price, StringFormat=N2}" Width="90"/>
                <DataGridTextColumn Header="Создан" Binding="{Binding CreatedAt, StringFormat=dd.MM.yyyy}" Width="95"/>
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
</UserControl>
